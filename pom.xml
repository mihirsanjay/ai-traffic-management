<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.mihir.traffic</groupId>
  <artifactId>ai-traffic-management</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>AI Traffic Management Platform</name>
  <description>Traffic management control plane: rule authoring, deployment, and observation</description>

  <modules>
    <module>common</module>
  </modules>

  <properties>
    <!--
      Target Java 21 LTS via <release>, NOT -source/-target. See ADR 0002:
      the local JDK is newer (26), and only <release> validates against the
      Java 21 API surface, turning "used an API that does not exist in 21"
      into a compile error rather than a runtime failure.
    -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Build tooling versions. Pinned explicitly: an unpinned plugin makes
         the build non-reproducible, since Maven would resolve differently
         over time and between machines. -->
    <spotless.version>3.9.0</spotless.version>
    <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
    <checkstyle.tool.version>13.10.0</checkstyle.tool.version>
    <spotbugs.version>4.10.3.0</spotbugs.version>
    <jacoco.version>0.8.15</jacoco.version>
    <enforcer.version>3.6.3</enforcer.version>
    <surefire.version>3.5.6</surefire.version>
    <failsafe.version>3.5.6</failsafe.version>

    <!-- Coverage floor. Deliberately low while the codebase is a skeleton:
         a high floor here either fails on an empty module or gets satisfied
         with vacuous tests. Raise this each phase as real logic lands.
         Per coding-standards.md, coverage is a floor that catches untested
         files, not a target to game. -->
    <jacoco.line.coverage>0.30</jacoco.line.coverage>

    <!-- Minimum toolchain. Enforced below so an unexpected local JDK fails
         loudly at validate rather than producing subtly different bytecode. -->
    <min.maven.version>3.9.0</min.maven.version>
    <min.jdk.version>21</min.jdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Module versions are managed here so child modules never declare a
           version. Spring Boot's parent BOM already manages third-party
           library versions. -->
      <dependency>
        <groupId>com.mihir.traffic</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Available to every module: JUnit 5, AssertJ, Mockito. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${failsafe.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- ==================================================================
           Quality gates. Every one of these FAILS the build rather than
           warning. Standards that only warn are standards that decay.
           ================================================================== -->

      <!-- Formatting: google-java-format. Not a code review topic; the tool
           decides. `mvn spotless:apply` fixes violations automatically. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <!--
            Java only. POM formatting is deliberately NOT managed here:
            sortPom collapses the multi-line <project> header onto one long
            line and reorders elements away from the order the Maven docs
            use, which costs readability and buys nothing. Formatting
            consistency matters most where humans read code, and
            google-java-format already handles that.
          -->
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Structure: naming, imports, complexity, banned constructs.
           Rules derive from docs/coding-standards.md. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle.plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.tool.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <failsOnError>true</failsOnError>
          <violationSeverity>warning</violationSeverity>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Correctness and concurrency bug patterns. -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Coverage floor. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Toolchain and dependency hygiene. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer.version}</version>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[${min.maven.version},)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[${min.jdk.version},)</version>
                </requireJavaVersion>
                <!-- Two versions of the same library on the classpath is a
                     latent NoSuchMethodError. Fail now, not in production. -->
                <dependencyConvergence/>
                <banDuplicatePomDependencyVersions/>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
