<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions.

  Keep this file SHORT. Every entry is a bug pattern this project has decided
  not to hear about, and each one is a place a real bug could hide. Add an
  exclusion only with a comment explaining why the warning is wrong here -
  never merely because it is inconvenient.
-->
<FindBugsFilter>

  <!-- Test code: assertions and fixtures legitimately trip patterns that
       matter in production code (unread fields, hardcoded values, ignored
       return values from builders). -->
  <Match>
    <Source name="~.*[\\/]src[\\/]test[\\/].*"/>
  </Match>

  <!-- Generated sources are not ours to fix. -->
  <Match>
    <Source name="~.*[\\/]generated-sources[\\/].*"/>
  </Match>

  <!--
    EI_EXPOSE_REP / EI_EXPOSE_REP2 on records.

    SpotBugs flags records that hold references to mutable types (List, Date,
    arrays) because the record does not defensively copy. The project's answer
    per coding-standards.md is immutability by convention: records carry
    immutable collections (List.copyOf) and java.time types.

    Scoped to records only - the warning stays active for ordinary classes,
    where it usually indicates a real leak.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Source name="~.*[\\/]records[\\/].*"/>
  </Match>

  <!--
    EI_EXPOSE_REP2 on constructor-injected Spring collaborators.

    SpotBugs sees a constructor storing a reference to a mutable object and
    reports a leak. For a Spring bean that is the entire point: the container
    owns these singletons and injects the same instance everywhere, so copying
    one defensively would either break it (a ProxyManager holds a live Redis
    connection) or silently waste it. Constructor injection over field
    injection is what coding-standards.md requires, and this warning fires on
    correct code following that rule.

    Scoped to the classes where collaborators are injected rather than
    disabled globally - EI_EXPOSE_REP2 still applies to ordinary classes
    holding caller-supplied arrays or collections, where it finds real bugs.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Or>
      <Class name="com.mihir.traffic.ruleservice.ratelimit.RateLimitFilter"/>
      <!-- Holds RuleVersionAppender, whose proxied identity is load-bearing:
           copying it defensively would strip the transactional proxy and
           silently reintroduce the self-invocation bug that
           RuleVersionAppenderIntegrationTest exists to prevent. -->
      <Class name="com.mihir.traffic.ruleservice.service.RuleService"/>
      <!-- Holds OutboxWriter, for the same proxy reason as above: the writer's
           MANDATORY propagation only applies through the container's proxy. -->
      <Class name="com.mihir.traffic.ruleservice.service.RuleVersionAppender"/>
      <!-- Holds an ObjectMapper and a repository, both container singletons. -->
      <Class name="com.mihir.traffic.ruleservice.outbox.OutboxWriter"/>
      <!-- Holds a KafkaTemplate, which owns a live producer and its connection
           pool, and OutboxBatchClaimer, whose transactional proxy is the whole
           reason it is a separate bean. -->
      <Class name="com.mihir.traffic.ruleservice.outbox.OutboxPublisher"/>
      <Class name="com.mihir.traffic.ruleservice.outbox.OutboxBatchClaimer"/>
      <!-- deployment-service equivalents: same rule, same reasoning. -->
      <Class name="com.mihir.traffic.deploymentservice.kafka.RuleEventConsumer"/>
      <Class name="com.mihir.traffic.deploymentservice.service.DeploymentService"/>
    </Or>
  </Match>

</FindBugsFilter>
