# Local infrastructure overrides for docker-compose.yml.
#
# Every value here has a working default baked into docker-compose.yml, so
# this file is entirely optional -- copy it to infra/.env only if you need
# to change something (most commonly a port that is already in use):
#
#   cp infra/.env.example infra/.env
#
# infra/.env is gitignored. These are throwaway local credentials for a
# container bound to loopback; real secrets never live in this repository.

# --- PostgreSQL ---
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic
POSTGRES_DB=traffic
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Kafka ---
KAFKA_PORT=9092

# KRaft requires a stable cluster ID. Changing this on an existing volume
# makes the broker refuse to start, because the ID no longer matches the one
# recorded in its log directory. Change it only together with `down -v`.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
