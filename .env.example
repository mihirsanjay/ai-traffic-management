# Environment variables the platform accepts.
#
# Copy to `.env` and edit for a local override. `.env` is gitignored; this
# example file is not, and must never contain a real credential.
#
# Everything here has a working default baked into the relevant
# application.yml or docker-compose.yml, so the stack runs with no .env at
# all. These exist so that a deployment can supply values from outside the
# image -- which is what a secrets manager does in Phase 6.

# --- Application database credentials -------------------------------------
# Consumed by rule-service and deployment-service via ${VAR:default} in their
# application.yml. The defaults match the local Postgres container.
DB_USERNAME=traffic
DB_PASSWORD=traffic

# Full JDBC URL. Left unset locally so each service uses its own database
# (rule_service / deployment_service); set it only to point a service
# somewhere else entirely.
# DB_URL=jdbc:postgresql://localhost:5432/rule_service

# --- Local infrastructure (infra/docker-compose.yml) -----------------------
# These configure the containers themselves rather than the applications.
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic
POSTGRES_DB=traffic
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092

# --- Spring relaxed binding -----------------------------------------------
# Any property in an application.yml can be overridden by uppercasing it and
# replacing dots with underscores. infra/docker-compose.services.yml uses
# this to point containers at compose hostnames instead of localhost:
#
#   SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rule_service
#   SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
#   SPRING_DATA_REDIS_HOST=redis
#
# No entry is needed here for those -- they are set per-container in the
# compose file, which is the right place for deployment-shaped configuration.

# --- CI secrets -----------------------------------------------------------
# NOT set here. Workflow secrets live in GitHub Actions repository secrets
# (Settings -> Secrets and variables -> Actions), encrypted by GitHub and
# never present in this repository. See docs/cicd.md.
#
#   ANTHROPIC_API_KEY   - used by .github/workflows/claude.yml
