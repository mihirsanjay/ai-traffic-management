<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.mihir.traffic</groupId>
    <artifactId>ai-traffic-management</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>common</artifactId>
  <name>common</name>
  <description>
    Code shared across services: event schemas, shared error types.

    Deliberately narrow. Per ADR 0003, a shared module attracts unrelated code
    and quietly couples services that should be independent. If something is
    used by exactly one service, it belongs in that service.

    Holds the event contracts as of Phase 2.
  </description>

  <dependencies>
    <!-- Annotations only, deliberately: NOT jackson-databind, NOT spring-kafka,
         NOT spring-boot-starter-web.

         The moment this module depends on Kafka or Spring, every consumer of an
         event schema inherits that classpath - including the Phase 3 simulators,
         which roadmap.md requires to have no dependency on any platform module
         at all. Annotations keep this a pure schema definition.

         Versions are managed by the Boot BOM; declaring one here is what
         dependencyConvergence rejects. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>

    <!-- Test scope only, and deliberately so. The event contract is a wire
         format, so the tests must actually serialize it - asserting on record
         equality alone would prove nothing about the JSON that crosses the
         process boundary. Keeping these at test scope means a consuming service
         brings its own mapper (Spring Boot's, already configured) rather than
         inheriting one from a schema module.

         Note the groupId: Spring Boot 4 ships Jackson 3, which moved from
         com.fasterxml.jackson to tools.jackson. The annotations above kept the
         old coordinates; databind did not. Jackson 3 also handles java.time
         natively, so no separate jsr310 module is needed.

         spring-boot-starter-test supplies JUnit, AssertJ, and Mockito but not
         databind, so it has to be named explicitly. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
